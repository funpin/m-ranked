@startuml MRanked_Current_SQLite_ERD
title M-Ranked — ERD текущей SQLite (schema version 14, AS-IS)

hide circle
skinparam linetype ortho
skinparam entity {
  BackgroundColor White
  BorderColor #455A64
}

entity schema_migrations {
  * version : INTEGER <<PK>>
  --
  applied_at : TEXT
}

entity app_state {
  * key : TEXT <<PK>>
  --
  value : TEXT
}

entity institutions {
  * id : INTEGER <<PK>>
  --
  name : TEXT
  short_name : TEXT?
  created_at : TEXT
  m_rating_social_rank : INTEGER?
  m_rating_social_score : REAL?
  m_rating_tg_rank : INTEGER?
  m_rating_tg_score : REAL?
  m_rating_vk_rank : INTEGER?
  m_rating_vk_score : REAL?
  m_rating_max_rank : INTEGER?
  m_rating_max_score : REAL?
  m_rating_rutube_rank : INTEGER?
  m_rating_rutube_score : REAL?
  m_rating_period : TEXT?
  m_rating_measured_at : TEXT?
}

entity platform_accounts {
  * id : INTEGER <<PK>>
  --
  institution_id : INTEGER <<FK>>
  platform : TEXT
  external_key : TEXT
  native_id : TEXT?
  username : TEXT?
  title : TEXT?
  url : TEXT?
  enabled : INTEGER
  access_mode : TEXT
  data_quality : TEXT
  subscriber_count : INTEGER?
  subscriber_count_display : TEXT?
  subscriber_measured_at : TEXT?
  last_checked_at : TEXT?
  last_error : TEXT?
  added_at : TEXT
  --
  UQ(platform, external_key)
}

entity platform_posts {
  * id : INTEGER <<PK>>
  --
  platform_account_id : INTEGER <<FK>>
  external_id : TEXT
  published_at : TEXT
  discovered_at : TEXT
  post_type : TEXT
  url : TEXT?
  deleted_at : TEXT?
  missing_check_count : INTEGER
  missing_last_checked_at : TEXT?
  missing_reason : TEXT?
  raw_json : TEXT?
  history_complete : INTEGER
  history_forced_incomplete : INTEGER
  source_external_id : TEXT?
  is_joint : INTEGER
  additional_author_count : INTEGER
  is_repost : INTEGER
  created_at : TEXT
  --
  UQ(platform_account_id, external_id)
}

entity platform_snapshots {
  * id : INTEGER <<PK>>
  --
  platform_post_id : INTEGER <<FK>>
  measured_at : TEXT
  measurement_bucket : INTEGER
  age_seconds : INTEGER
  views_count : INTEGER?
  reactions_count : INTEGER?
  comments_count : INTEGER?
  shares_count : INTEGER?
  raw_json : TEXT?
  created_at : TEXT
  --
  UQ(platform_post_id, measurement_bucket)
}

entity channels <<legacy Telegram>> {
  * id : INTEGER <<PK>>
  --
  telegram_id : INTEGER?
  username : TEXT <<UQ>>
  title : TEXT?
  enabled : INTEGER
  added_at : TEXT
  last_seen_message_id : INTEGER
  last_checked_at : TEXT?
  last_error : TEXT?
  subscriber_count : INTEGER?
  subscriber_count_display : TEXT?
  subscriber_measured_at : TEXT?
  m_rating_tg_rank : INTEGER?
  m_rating_tg_score : REAL?
  m_rating_period : TEXT?
  m_rating_measured_at : TEXT?
  institution_id : INTEGER? <<logical ref only>>
  platform_account_id : INTEGER? <<logical ref only>>
}

entity posts <<legacy Telegram>> {
  * id : INTEGER <<PK>>
  --
  channel_id : INTEGER <<FK>>
  logical_key : TEXT
  telegram_message_id : INTEGER
  telegram_grouped_id : INTEGER?
  published_at : TEXT
  discovered_at : TEXT
  first_observation_age_seconds : INTEGER
  history_complete : INTEGER
  history_forced_incomplete : INTEGER
  baseline_from_publication : INTEGER
  post_type : TEXT
  ambiguous_album_reactions : INTEGER
  is_repost : INTEGER
  deleted_at : TEXT?
  missing_check_count : INTEGER
  missing_last_checked_at : TEXT?
  missing_reason : TEXT?
  created_at : TEXT
  --
  UQ(channel_id, logical_key)
  UQ(channel_id, telegram_message_id)
}

entity post_messages <<legacy Telegram album members>> {
  * post_id : INTEGER <<PK, FK>>
  * telegram_message_id : INTEGER <<PK>>
}

entity reaction_snapshots <<legacy Telegram>> {
  * id : INTEGER <<PK>>
  --
  post_id : INTEGER <<FK>>
  measured_at : TEXT
  measurement_bucket : INTEGER
  age_seconds : INTEGER
  total_reactions : INTEGER
  reactions_json : TEXT
  raw_state_json : TEXT?
  delta_total : INTEGER?
  delta_by_reaction_json : TEXT?
  delta_seconds : INTEGER?
  rate_per_hour : REAL?
  interval_uncertain : INTEGER
  spike : INTEGER
  comments_count : INTEGER?
  delta_comments : INTEGER?
  views_count : INTEGER?
  delta_views : INTEGER?
  synthetic : INTEGER
  created_at : TEXT
  --
  UQ(post_id, measurement_bucket)
}

institutions ||--o{ platform_accounts : institution_id
platform_accounts ||--o{ platform_posts : platform_account_id / CASCADE
platform_posts ||--o{ platform_snapshots : platform_post_id / CASCADE
channels ||--o{ posts : channel_id
posts ||--o{ post_messages : post_id / CASCADE
posts ||--o{ reaction_snapshots : post_id / CASCADE
institutions |o..o{ channels : institution_id (no SQLite FK)
platform_accounts |o..o| channels : platform_account_id (no SQLite FK)

note bottom of channels
  Legacy Telegram и generic platform model существуют параллельно.
  История Telegram не была перенесена в platform_posts/platform_snapshots.
end note

note bottom of institutions
  M-Рейтинг хранится как последнее значение и перезаписывается;
  отдельной истории import/run нет.
end note

note right of platform_snapshots
  raw_json повторяется в каждом snapshot.
  Retention/архивирование для этой таблицы сейчас отсутствует.
end note
@enduml
