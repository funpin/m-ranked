@startuml MRanked_Collector_Components
!include <C4/C4_Component>
title M-Ranked — collector components
LAYOUT_LEFT_RIGHT()

System_Ext(platforms, "Telegram / VK / MAX / Rutube", "Provider APIs")
ContainerDb_Ext(pg, "PostgreSQL", "PostgreSQL", "Accounts, runs and observations")

Container_Boundary(collectors, "Python collector runtime") {
  Component(scheduler, "Poll coordinator", "asyncio", "Bounded cycles and concurrency")
  Component(lease, "Advisory lease", "psycopg", "One platform/partition owner")
  Component(adapters, "Platform adapters", "Telethon/httpx/Playwright/PyMax", "Raw provider DTO")
  Component(normalizer, "Canonical normalizer", "Python", "Identity, quality and NULL/zero")
  Component(writer, "Repository", "psycopg", "Atomic observation, lineage, revision and outbox")
  Component(runlog, "Run recorder", "Python", "Bounded status and sanitized errors")
}

Rel(scheduler, lease, "Acquire/release")
Rel(lease, pg, "pg advisory lock")
Rel(scheduler, adapters, "Collect enabled accounts")
Rel(adapters, platforms, "Read")
Rel(adapters, normalizer, "Raw batch")
Rel(normalizer, writer, "Validated batch")
Rel(writer, pg, "Transactional SQL")
Rel(scheduler, runlog, "Status")
Rel(runlog, pg, "SQL")
SHOW_LEGEND()
@enduml
