@startuml MRanked_Containers
!include <C4/C4_Container>
title M-Ranked — runtime containers
LAYOUT_LEFT_RIGHT()

Person(visitor, "Посетитель", "Страницы, графики и API")
Person(admin, "Администратор", "Каталог и проверки")
Person(operator, "Оператор", "Health, backup и restore")
System_Ext(networks, "Telegram / VK / MAX / Rutube", "Публичные данные и API")
System_Ext(mrating, "m-rating.ru", "Официальные результаты")

System_Boundary(system, "M-Ranked — один release train") {
  Container(edge, "Edge", "Nginx", "TLS и reverse proxy")
  Container(web, "Web", "Next.js / TypeScript", "SSR и интерактивный UI")
  Container(api, "API", "Python / FastAPI", "Public/admin API, auth, exports и LRU")
  Container(collectors, "Collectors", "Python / asyncio", "Четыре изолированных platform runtime")
  Container(anomaly, "Anomaly worker", "Python", "Воспроизводимый анализ динамики")
  ContainerDb(pg, "PostgreSQL", "PostgreSQL 18", "Source of truth, revisions, audit и outbox")
  ContainerDb(cold, "Cold archive", "Parquet + Zstandard", "Проверенные архивные объекты")
}

Rel(visitor, edge, "HTTPS")
Rel(admin, edge, "HTTPS")
Rel(edge, web, "HTTP")
Rel(edge, api, "HTTP/JSON")
Rel(web, api, "OpenAPI/JSON")
Rel(api, pg, "psycopg; read/admin/outbox roles")
Rel(collectors, networks, "HTTPS/MTProto")
Rel(collectors, pg, "psycopg; ingest role")
Rel(anomaly, pg, "psycopg; analytics role")
Rel(api, mrating, "Pinned HTTPS import")
Rel(operator, pg, "metrics/backup")
Rel(pg, cold, "bounded archive")
SHOW_LEGEND()
@enduml
