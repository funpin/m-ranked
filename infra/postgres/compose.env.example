# Copy to a file outside version control and replace every value.
# Compose deliberately has no usable default password.
POSTGRES_SUPERUSER_PASSWORD=replace-with-long-random-secret
MIGRATION_DB_PASSWORD=replace-with-long-random-secret
API_READ_DB_PASSWORD=replace-with-long-random-secret
API_WRITE_ADMIN_DB_PASSWORD=replace-with-long-random-secret
COLLECTOR_INGEST_DB_PASSWORD=replace-with-long-random-secret
BACKUP_DB_PASSWORD=replace-with-long-random-secret
MIGRATION_BRIDGE_DB_PASSWORD=replace-with-long-random-secret
MAINTENANCE_DB_PASSWORD=replace-with-long-random-secret
REDIS_PASSWORD=replace-with-long-random-secret

POSTGRES_PORT=5432
REDIS_PORT=6379
