[Unit]
Description=M-Ranked bounded PostgreSQL-to-legacy rollback projection
Documentation=file:/opt/m-ranked/current/operations/runbooks/ROLLBACK.md
After=network-online.target
Wants=network-online.target
Conflicts=m-ranked-collector.service

[Service]
Type=simple
User=telegram-monitor
Group=telegram-monitor
WorkingDirectory=/opt/m-ranked/current
EnvironmentFile=/etc/m-ranked/reverse-sync.env
LoadCredential=pgpass:/etc/m-ranked/credentials/migration-bridge-pgpass
Environment=MIGRATION_PGPASSFILE=%d/pgpass
Environment=TZ=UTC
ExecStart=/opt/m-ranked/current/operations/bin/pg-to-legacy-sync run
Restart=on-failure
RestartSec=5s
TimeoutStartSec=2min
TimeoutStopSec=30s
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
StateDirectory=m-ranked-reverse-sync
StateDirectoryMode=0700
ReadWritePaths=/opt/telegram-reaction-monitor/data
UMask=0077
LimitNOFILE=4096
TasksMax=32
