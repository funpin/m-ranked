[Unit]
Description=M-Ranked aggregate memory envelope for all four collectors

[Slice]
MemoryHigh=650M
MemoryMax=700M
MemorySwapMax=0
TasksMax=1024
# Ядро на машине одно, и сборщики держат его занятым непрерывно. Без веса
# запрос страницы вставал в общую очередь наравне с ними и ждал своей доли.
# Вес не останавливает сбор и не отнимает время, пока никто не читает: он
# решает только, кто уступает при столкновении.
CPUWeight=20
IOWeight=50
