[Unit]
Description=M-Ranked independent publication anomaly analysis worker
Documentation=file:/opt/m-ranked/current/operations/runbooks/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=m-ranked-anomaly
Group=m-ranked-anomaly
SupplementaryGroups=node-exporter
WorkingDirectory=/opt/m-ranked/current
EnvironmentFile=/etc/m-ranked/anomaly-analysis.env
LoadCredential=pgpass:/etc/m-ranked/credentials/anomaly-pgpass
Environment=PGPASSFILE=%d/pgpass
Environment=TZ=UTC
ExecStart=/opt/m-ranked/current/.venv/bin/python -m anomaly_analysis
Restart=on-failure
RestartSec=10s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/node_exporter/textfile_collector
RuntimeDirectory=m-ranked-anomaly
RuntimeDirectoryMode=0700
UMask=0077
MemoryMax=512M
LimitNOFILE=4096
TasksMax=32

[Install]
WantedBy=m-ranked-target.target
