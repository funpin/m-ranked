[Unit]
Description=Snapshot the M-Rating social forecast once a day

[Timer]
# До ночного дампа. Официальный рейтинг грузит только кнопка панели, и она
# сама сразу пересчитывает прогноз; ночной прогон обновляет бегущую оценку.
OnCalendar=*-*-* 01:47:00
RandomizedDelaySec=10min
Persistent=true
AccuracySec=5min
Unit=m-ranked-target-rating-forecast.service

[Install]
WantedBy=timers.target
