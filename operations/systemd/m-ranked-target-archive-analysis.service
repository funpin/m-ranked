[Unit]
Description=M-Ranked repeated analysis of an archived month (panel job, ADR-016)
Documentation=file:/opt/m-ranked/current/operations/runbooks/COLD_ARCHIVE.md
After=network-online.target m-ranked-target-anomaly-analysis.service
Wants=network-online.target

[Service]
Type=oneshot
User=m-ranked-anomaly
Group=m-ranked-anomaly
WorkingDirectory=/opt/m-ranked/current
EnvironmentFile=/etc/m-ranked/anomaly-analysis.env
LoadCredential=pgpass:/etc/m-ranked/credentials/anomaly-pgpass
ExecStartPre=+/usr/bin/install -m 0600 -o m-ranked-anomaly -g m-ranked-anomaly %d/pgpass /run/m-ranked-archive-analysis/pgpass
Environment=PGPASSFILE=/run/m-ranked-archive-analysis/pgpass
Environment=TZ=UTC
# Задание само ничего не считает: снимает заморозку с постов месяца и ждёт,
# пока работник анализа заморозит их снова (не дольше 12 часов).
ExecStart=/opt/m-ranked/current/.venv/bin/python -m anomaly_analysis.v2.archive_job
TimeoutStartSec=13h
Nice=10
CPUQuota=10%
MemoryMax=128M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
RuntimeDirectory=m-ranked-archive-analysis
RuntimeDirectoryMode=0700
UMask=0077
TasksMax=16
