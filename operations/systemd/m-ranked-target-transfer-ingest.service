[Unit]
Description=M-Ranked profile B mTLS transfer receiver
Documentation=file:/opt/m-ranked/current/operations/runbooks/DEPLOY.md
After=network-online.target
Wants=network-online.target
AssertPathExists=/etc/m-ranked/transfer-ingest.env

[Service]
Type=simple
User=m-ranked-transfer-ingest
Group=m-ranked-transfer-ingest
SupplementaryGroups=node-exporter
WorkingDirectory=/opt/m-ranked/current
EnvironmentFile=/etc/m-ranked/transfer-ingest.env
LoadCredential=pgpass:/etc/m-ranked/credentials/transfer-ingest-pgpass
LoadCredential=server-certificate:/etc/m-ranked/credentials/transfer-server.crt
LoadCredential=server-private-key:/etc/m-ranked/credentials/transfer-server.key
LoadCredential=transfer-ca:/etc/m-ranked/credentials/transfer-ca.crt
Environment=PGPASSFILE=%d/pgpass
Environment=TRANSFER_INGEST_CERTIFICATE=%d/server-certificate
Environment=TRANSFER_INGEST_PRIVATE_KEY=%d/server-private-key
Environment=TRANSFER_INGEST_CA_BUNDLE=%d/transfer-ca
Environment=PYTHONUNBUFFERED=1
Environment=TZ=UTC
ExecStart=/opt/m-ranked/current/.venv/bin/python -m transfer_ingest
Restart=on-failure
RestartSec=10s
TimeoutStartSec=30s
TimeoutStopSec=45s
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Base policy accepts no network peer. The rendered Server 2 drop-in adds only
# exact Server 1/VPN source prefixes; the host firewall enforces the same list.
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
ReadWritePaths=-/var/lib/node_exporter/textfile_collector
RuntimeDirectory=m-ranked-transfer-ingest
RuntimeDirectoryMode=0700
UMask=0077
LimitNOFILE=8192
TasksMax=64
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=0

[Install]
WantedBy=m-ranked-target-profile-b-server2.target
