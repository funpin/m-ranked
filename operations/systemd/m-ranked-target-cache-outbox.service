[Unit]
Description=M-Ranked PostgreSQL to Redis cache-revision outbox
Documentation=file:/opt/m-ranked/current/operations/runbooks/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=m-ranked-outbox
Group=m-ranked-outbox
WorkingDirectory=/opt/m-ranked/current
EnvironmentFile=/etc/m-ranked/cache-outbox.env
LoadCredential=pgpass:/etc/m-ranked/credentials/outbox-pgpass
LoadCredential=redis-password:/etc/m-ranked/credentials/redis-password
Environment=PGPASSFILE=%d/pgpass
Environment=REDIS_PASSWORD_FILE=%d/redis-password
Environment=TZ=UTC
ExecStart=/opt/m-ranked/current/operations/scripts/cache-outbox-worker.sh
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
RuntimeDirectory=m-ranked-outbox
RuntimeDirectoryMode=0700
UMask=0077
LimitNOFILE=8192
TasksMax=64

[Install]
WantedBy=m-ranked-shadow.target
