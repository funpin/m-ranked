[Unit]
Description=M-Ranked explicit bounded core projection publication
Documentation=file:/opt/m-ranked/current/operations/runbooks/DEPLOY.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
User=m-ranked-maintenance
Group=m-ranked-maintenance
WorkingDirectory=/opt/m-ranked/current
EnvironmentFile=/etc/m-ranked/projection-publisher.env
LoadCredential=pgpass:/etc/m-ranked/credentials/maintenance-pgpass
Environment=PGPASSFILE=%d/pgpass
Environment=TZ=UTC
ExecStart=/opt/m-ranked/current/operations/scripts/projection-publisher.sh --once
Restart=no
TimeoutStartSec=2h
TimeoutStopSec=30s
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
RuntimeDirectory=m-ranked-projection-publisher
RuntimeDirectoryMode=0700
UMask=0077
LimitNOFILE=8192
TasksMax=64
