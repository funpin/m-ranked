[Unit]
Description=M-Ranked latest-revision core projection publisher
Documentation=file:/opt/m-ranked/current/operations/runbooks/DEPLOY.md
After=network-online.target
Wants=network-online.target
Before=m-ranked-target-collector@telegram.service
Before=m-ranked-target-collector@vk.service
Before=m-ranked-target-collector@max.service
Before=m-ranked-target-collector@rutube.service

[Service]
Type=simple
User=m-ranked-maintenance
Group=m-ranked-maintenance
WorkingDirectory=/opt/m-ranked/current
EnvironmentFile=/etc/m-ranked/projection-publisher.env
LoadCredential=pgpass:/etc/m-ranked/credentials/maintenance-pgpass
Environment=PGPASSFILE=%d/pgpass
Environment=TZ=UTC
ExecStartPre=/opt/m-ranked/current/operations/scripts/projection-publisher.sh --once
ExecStart=/opt/m-ranked/current/operations/scripts/projection-publisher.sh
Restart=on-failure
RestartSec=5s
TimeoutStartSec=20min
TimeoutStopSec=30s
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
RuntimeDirectory=m-ranked-projection-publisher
RuntimeDirectoryMode=0700
UMask=0077
LimitNOFILE=8192
TasksMax=64

[Install]
WantedBy=m-ranked-shadow.target
