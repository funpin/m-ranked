[Unit]
Description=M-Ranked profile A single-host runtime
Documentation=file:/opt/m-ranked/current/operations/runbooks/DEPLOY.md
Conflicts=m-ranked-target-profile-b-server1.target m-ranked-target-profile-b-server2.target
Requires=m-ranked-target-api.service m-ranked-target-web.service
Wants=m-ranked-target-collector@telegram.service
Wants=m-ranked-target-collector@vk.service
Wants=m-ranked-target-collector@max.service
Wants=m-ranked-target-collector@rutube.service
Wants=m-ranked-target-collectors.slice
Wants=m-ranked-target-maintenance.timer
Wants=m-ranked-target-web-cache-gc.timer
Wants=m-ranked-target-anomaly-analysis.service
Wants=m-ranked-target-anomaly-norms.timer
Wants=m-ranked-target-collector-watchdog.timer
Wants=m-ranked-target-official-rating.timer
Wants=m-ranked-target-overview-metrics.timer
After=network-online.target m-ranked-target-api.service

[Install]
WantedBy=multi-user.target
