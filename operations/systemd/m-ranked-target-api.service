[Unit]
Description=M-Ranked target Spring API
Documentation=file:/opt/m-ranked/current/operations/runbooks/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=m-ranked-api
Group=m-ranked-api
WorkingDirectory=/opt/m-ranked/current/backend
EnvironmentFile=/etc/m-ranked/api.env
LoadCredential=spring.datasource.password:/etc/m-ranked/credentials/api-read-db-password
LoadCredential=spring.data.redis.password:/etc/m-ranked/credentials/redis-password
Environment=SPRING_CONFIG_IMPORT=configtree:%d/
Environment=TZ=UTC
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=70 -Duser.timezone=UTC -jar /opt/m-ranked/current/backend/m-ranked-backend.jar
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=-/var/lib/m-ranked/api
RuntimeDirectory=m-ranked-api
RuntimeDirectoryMode=0750
UMask=0077
LimitNOFILE=65536
TasksMax=512

[Install]
WantedBy=m-ranked-shadow.target
