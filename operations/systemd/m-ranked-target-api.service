[Unit]
Description=M-Ranked FastAPI application
Documentation=file:/opt/m-ranked/current/operations/runbooks/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=m-ranked-api
Group=m-ranked-api
SupplementaryGroups=node-exporter
WorkingDirectory=/opt/m-ranked/current
EnvironmentFile=/etc/m-ranked/api.env
EnvironmentFile=-/etc/m-ranked/api-profile.env
LoadCredential=api-read-db-password:/etc/m-ranked/credentials/api-read-db-password
LoadCredential=api-write-admin-db-password:/etc/m-ranked/credentials/api-write-admin-db-password
LoadCredential=outbox-worker-db-password:/etc/m-ranked/credentials/outbox-worker-db-password
LoadCredential=admin-auth-users:/etc/m-ranked/credentials/admin-auth-users.json
LoadCredential=admin-csrf-secret:/etc/m-ranked/credentials/admin-csrf-secret
Environment=API_READ_DB_PASSWORD_FILE=%d/api-read-db-password
Environment=API_WRITE_ADMIN_DB_PASSWORD_FILE=%d/api-write-admin-db-password
Environment=OUTBOX_WORKER_DB_PASSWORD_FILE=%d/outbox-worker-db-password
Environment=ADMIN_AUTH_USERS_FILE=%d/admin-auth-users
Environment=ADMIN_CSRF_SECRET_FILE=%d/admin-csrf-secret
Environment=MRANKED_IDENTITY_RECEIPT_DIR=/var/lib/m-ranked/identity-receipts
Environment=MRANKED_SECURITY_METRICS_FILE=/var/lib/node_exporter/textfile_collector/m-ranked-api-security.prom
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/Moscow
# A crashed worker leaves a PID-named Prometheus textfile. The next API master
# removes every stale worker file before it starts publishing a fresh set.
ExecStartPre=/usr/bin/find /var/lib/node_exporter/textfile_collector -maxdepth 1 -type f -name m-ranked-api-cache-*.prom -delete
ExecStart=/opt/m-ranked/current/operations/scripts/run-api.sh
Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=-/var/lib/m-ranked/api -/var/lib/m-ranked/identity-receipts/admin
ReadWritePaths=-/var/lib/node_exporter/textfile_collector
RuntimeDirectory=m-ranked-api
RuntimeDirectoryMode=0750
UMask=0077
LimitNOFILE=65536
TasksMax=512
# Отдача страницы должна выигрывать у фонового сбора: ядро одно.
CPUWeight=400
# Потолок: набег роботов не должен забирать оба ядра у соседних проектов.
CPUQuota=120%
IOWeight=200
MemoryHigh=320M
MemoryMax=384M
MemorySwapMax=0

[Install]
WantedBy=m-ranked-target.target
