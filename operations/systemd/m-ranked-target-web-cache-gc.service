[Unit]
Description=Bound active M-Ranked Next.js fetch cache
Documentation=file:/opt/m-ranked/current/operations/runbooks/DEPLOY.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=TZ=UTC
EnvironmentFile=/etc/m-ranked/web-cache-gc.env
ExecStartPre=-/usr/bin/docker rm -f m-ranked-target-web-cache-gc
ExecStart=/usr/bin/docker run --rm --name m-ranked-target-web-cache-gc --network none --user ${MRANKED_WEB_CACHE_GC_UID_GID} --read-only --cap-drop=ALL --security-opt=no-new-privileges:true --memory=64m --memory-swap=64m --pids-limit=32 --tmpfs=/tmp:rw,noexec,nosuid,size=8m --env=MRANKED_WEB_CACHE_ROOT=/cache --env=MRANKED_WEB_CACHE_MAX_AGE_SECONDS=3600 --env=MRANKED_WEB_CACHE_MAX_BYTES=134217728 --env=MRANKED_WEB_CACHE_TARGET_BYTES=100663296 -v /usr/local/libexec/m-ranked/gc-next-cache.mjs:/gc-next-cache.mjs:ro -v /var/lib/m-ranked/web-cache:/cache ${MRANKED_WEB_CACHE_GC_IMAGE} node /gc-next-cache.mjs
ExecStop=-/usr/bin/docker stop --time 10 m-ranked-target-web-cache-gc
TimeoutStartSec=5min
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
UMask=0077
LimitNOFILE=32768
TasksMax=32

[Install]
WantedBy=multi-user.target
