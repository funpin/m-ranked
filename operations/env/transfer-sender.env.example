# Устанавливается как /etc/m-ranked/transfer-sender.env на Сервере 1 профиля B.
#
# Отправитель разбирает очередь transfer_outbox до нуля и работает рядом со
# штатным продюсером сборщика: доставка идемпотентна по batch_id.
COLLECTOR_DATABASE_URL=postgresql://outbox_worker@127.0.0.1:5432/mranked?sslmode=prefer
COLLECTOR_TRANSFER_PRODUCER_ID=server-1
# Как часто опрашивать очередь. Требование эксплуатации — свежий замер на
# Сервере 2 не позже чем через десять минут; пятнадцать секунд дают запас.
COLLECTOR_TRANSFER_SENDER_INTERVAL_SECONDS=15
# Сколько конвертов за один проход. Проход повторяется, пока очередь не пуста,
# поэтому предел ограничивает длительность одного шага, а не общий объём.
COLLECTOR_TRANSFER_SENDER_BATCH_LIMIT=50
COLLECTOR_TRANSFER_SENDER_METRICS_FILE=/var/lib/node_exporter/textfile_collector/m-ranked-transfer-sender.prom
LOG_LEVEL=INFO
# Сколько держать подтверждённые конверты. Они хранят полезную нагрузку
# и после доставки: окно нужно не ради места, а ради замены — если
# потребитель потеряет данные, отдать их заново можно только пока
# конверт цел. Ноль отключает очистку, и очередь растёт без предела.
COLLECTOR_TRANSFER_SENDER_RETENTION_HOURS=48
COLLECTOR_TRANSFER_SENDER_PURGE_LIMIT=2000
