# Один предыдущий релиз остаётся для быстрого rollback. Каталоги, которыми
# пользуются процессы или Docker bind mounts, всегда защищены автоматически.
MRANKED_RELEASE_KEEP_ROLLBACKS=1
MRANKED_RELEASE_MIN_AGE_HOURS=24

# Удаляются только неиспользуемые Docker-объекты старше недели. Volumes без
# label m-ranked.gc=ephemeral никогда автоматически не удаляются.
MRANKED_DOCKER_PRUNE_AGE_HOURS=168
MRANKED_DOCKER_PRUNE_ENABLED=1
