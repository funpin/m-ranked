# Текущий релиз, столько последних для отката, ссылки юнитов и занятые
# процессами/контейнерами не удаляются никогда.
MRANKED_RELEASE_KEEP_ROLLBACKS=2
MRANKED_RELEASE_MIN_AGE_HOURS=24
# 1 — удалять все прочие релизы старше порога без поимённого одобрения.
MRANKED_RELEASE_AUTO_REMOVE=1
# Protect agreed rollback + forensic releases by basename, comma separated.
MRANKED_PROTECTED_RELEASES=
# Only names approved after reviewing physical bytes (used when auto-remove=0).
MRANKED_APPROVED_RELEASE_REMOVALS=
# Blanket Docker GC is retired: other projects share the host. Only the
# reclaimable size is reported (alert MRankedDockerReclaimable).
MRANKED_DOCKER_PRUNE_ENABLED=0
MRANKED_HOST_GC_METRICS_FILE=/var/lib/node_exporter/textfile_collector/mranked-host-gc.prom
