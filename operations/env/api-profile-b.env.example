# Installed as /etc/m-ranked/api-profile.env on Profile B Server 2.
API_DEPLOYMENT_PROFILE=b
API_WORKERS=4
# Одна запись на логический запрос: каталог со свежими постами — несколько
# тысяч записей. Память ограничивает maxmemory Redis, а не это число.
API_CACHE_ENTRIES=8192
# Час вместо десяти минут: прогрев держит весь каталог, и запись должна
# дожить до следующего прохода, чтобы посетитель никогда не ждал пересборку.
# Свежесть задаёт не TTL, а фоновый пересчёт и возраст прогрева.
API_CACHE_TTL_SECONDS=3600
# Фоновых пересчётов — по одному на воркер: воркеров четыре, ядер два.
API_CACHE_REFRESH_CONCURRENCY=1
# Страницы открываются с этими параметрами по умолчанию: главная — каждая
# площадка за сутки, сравнение — сводка за 7 и 30 дней, «Находки» — все вузы
# за 7 дней списком и по вузам. Ключ кэша строится из нормализованного
# запроса, поэтому греть надо ровно их.
API_CACHE_WARMUP_TARGETS=["/api/v1/overview?platform=telegram&period=1d&limit=50","/api/v1/overview?platform=vk&period=1d&limit=50","/api/v1/overview?platform=max&period=1d&limit=50","/api/v1/overview?platform=rutube&period=1d&limit=50","/api/v1/overview?platform=all&period=1d&limit=50","/api/v1/compare/dashboard?period=30d","/api/v1/compare/dashboard?period=7d","/api/v1/findings?period=7d","/api/v1/findings?period=7d&group=institution","/api/v1/site/summary"]
API_CACHE_WARMUP_INTERVAL_SECONDS=60
API_CACHE_WARMUP_CATALOG=true
API_CACHE_WARMUP_RECENT_HOURS=6
API_CACHE_WARMUP_MAX_AGE_SECONDS=600
API_CACHE_WARMUP_CONCURRENCY=1
API_CACHE_WARMUP_BASE_URL=http://127.0.0.1:8080
