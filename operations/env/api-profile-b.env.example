# Installed as /etc/m-ranked/api-profile.env on Profile B Server 2.
API_DEPLOYMENT_PROFILE=b
API_WORKERS=4
API_CACHE_WARMUP_TARGETS=["/api/v1/overview","/api/v1/statistics?platform=telegram","/api/v1/statistics?platform=vk","/api/v1/statistics?platform=max","/api/v1/statistics?platform=rutube"]
API_CACHE_WARMUP_INTERVAL_SECONDS=300
API_CACHE_WARMUP_BASE_URL=http://127.0.0.1:8080
