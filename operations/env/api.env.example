SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
API_READ_DB_HOST=127.0.0.1
API_READ_DB_PORT=5432
API_READ_DB_NAME=mranked
API_READ_DB_USER=api_read
API_WRITE_ADMIN_DB_HOST=127.0.0.1
API_WRITE_ADMIN_DB_PORT=5432
API_WRITE_ADMIN_DB_NAME=mranked
API_WRITE_ADMIN_DB_USER=api_write_admin
OUTBOX_WORKER_DB_HOST=127.0.0.1
OUTBOX_WORKER_DB_PORT=5432
OUTBOX_WORKER_DB_NAME=mranked
OUTBOX_WORKER_DB_USER=outbox_worker
API_READ_POOL_MIN=2
API_READ_POOL_MAX=8
API_STATEMENT_TIMEOUT_MS=15000
# Профиль A оставляет LRU в процессе и один worker. Профиль B переключает
# response cache на Redis; развёртывание и credentials относятся к P2.4.
API_DEPLOYMENT_PROFILE=a
API_WORKERS=1
API_CACHE_ENTRIES=512
API_CACHE_TTL_SECONDS=600
API_CACHE_MIN_AGE_SECONDS=10
API_CACHE_STALE_SECONDS=60
API_CACHE_REFRESH_LOCK_SECONDS=150
API_REDIS_URL=redis://127.0.0.1:6379/0
API_REDIS_TIMEOUT_MS=250
API_CACHE_WARMUP_TARGETS=[]
API_CACHE_WARMUP_INTERVAL_SECONDS=300
API_CACHE_WARMUP_BASE_URL=http://127.0.0.1:8080
# Каталог создаёт P2.4; API пишет отдельный файл каждого worker по PID.
API_CACHE_METRICS_DIRECTORY=/var/lib/node_exporter/textfile_collector
API_CACHE_WARMUP_METRICS_FILE=/var/lib/node_exporter/textfile_collector/m-ranked-api-cache-warmup.prom
MRANKED_IDENTITY_RECEIPT_DIR=/var/lib/m-ranked/identity-receipts
