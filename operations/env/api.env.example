SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
APP_NAME=m-ranked-api
APP_BUILD_ID=replace-with-release-id
API_READ_DB_HOST=127.0.0.1
API_READ_DB_PORT=5432
API_READ_DB_NAME=mranked
API_READ_DB_USER=api_read
API_WRITE_ADMIN_DB_HOST=127.0.0.1
API_WRITE_ADMIN_DB_PORT=5432
API_WRITE_ADMIN_DB_NAME=mranked
API_WRITE_ADMIN_DB_USER=api_write_admin
OUTBOX_WORKER_DB_HOST=127.0.0.1
OUTBOX_WORKER_DB_PORT=5432
OUTBOX_WORKER_DB_NAME=mranked
OUTBOX_WORKER_DB_USER=outbox_worker
API_READ_POOL_MIN=2
API_READ_POOL_MAX=8
API_STATEMENT_TIMEOUT_MS=15000
API_MAX_BODY_BYTES=1048576
# Профиль A оставляет LRU в процессе и один worker. Профиль B переключает
# response cache на Redis; profile B overlay и credential описаны в DEPLOY.md.
API_DEPLOYMENT_PROFILE=a
API_WORKERS=1
API_CACHE_ENTRIES=512
# Предел несвежести: старше TTL ответ не отдаётся, и читатель ждёт пересборку.
API_CACHE_TTL_SECONDS=600
# Моложе FRESH ответ отдаётся как есть; старше — отдаётся сразу, а пересчёт
# идёт фоном, не больше REFRESH_CONCURRENCY пересчётов на процесс.
API_CACHE_FRESH_SECONDS=60
API_CACHE_REFRESH_CONCURRENCY=2
# Уведомление о записи не делает ответ несвежим раньше этого возраста.
API_CACHE_MIN_AGE_SECONDS=60
# Сколько держится опубликованная ревизия, по которой идут пересчёты и /revision.
API_CACHE_REVISION_HOLD_SECONDS=60
API_CACHE_REFRESH_LOCK_SECONDS=150
API_REDIS_URL=redis://127.0.0.1:6379/0
API_REDIS_TIMEOUT_MS=250
API_CACHE_WARMUP_TARGETS=[]
API_CACHE_WARMUP_INTERVAL_SECONDS=300
API_CACHE_WARMUP_BASE_URL=http://127.0.0.1:8080
# API пишет отдельный файл каждого worker по PID; unit чистит stale-файлы.
API_CACHE_METRICS_DIRECTORY=/var/lib/node_exporter/textfile_collector
API_CACHE_WARMUP_METRICS_FILE=/var/lib/node_exporter/textfile_collector/m-ranked-api-cache-warmup.prom
MRANKED_IDENTITY_RECEIPT_DIR=/var/lib/m-ranked/identity-receipts
PUBLICATION_RETENTION_DAYS=70
HEALTH_DATA_SOURCE=public_web
HEALTH_POLL_INTERVAL_MINUTES=60
HEALTH_MAX_PHONE_CONFIGURED=false
HEALTH_MAX_SESSION_EXISTS=false
INTEGRATION_TELEGRAM=configured
INTEGRATION_VK=configured
INTEGRATION_MAX=configured
INTEGRATION_RUTUBE=configured
ADMIN_REQUIRE_MFA=true
ADMIN_MIN_BCRYPT_COST=12
ADMIN_PASSWORD_VERIFIERS=2
ADMIN_SESSION_IDLE_SECONDS=1800
ADMIN_SESSION_ABSOLUTE_SECONDS=28800
ADMIN_TOTP_ATTEMPTS=5
ADMIN_LOGIN_ADDRESS_FAILURES=25
ADMIN_EXPECTED_ORIGIN=https://m.funpin.org
ADMIN_ALLOW_DEMO_SECRETS=false
ADMIN_ALLOW_EPHEMERAL_CSRF_SECRET=false
MRANKED_ADMIN_OFFICIAL_RATING_ENABLED=true
