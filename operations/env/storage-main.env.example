# Агент основного сервера (ADR-016). База — MAINTENANCE_DATABASE_URL из
# maintenance.env. Этот файл необязателен.

# Каталог законченных дампов dump-backup.sh: они становятся резервными
# копиями в хранилище (жёсткой ссылкой, без второй копии на диске).
BACKUP_DIR=/var/backups/m-ranked
# Группа, которой открыто хранилище: приёмник переноса и конвейер архива.
MRANKED_STORE_GROUP=m-ranked-storage
NODE_AGENT_UNITS=m-ranked-target-api.service m-ranked-target-transfer-ingest.service m-ranked-target-anomaly-analysis.service
