# Тревоги Сервера 2 (m-ranked-target-alerts.timer, раз в минуту).
#
# Telegram напрямую не используется: события тревог кладутся файлами в очередь
# бота, если каталог существует (иначе только в журнал службы:
# journalctl -u m-ranked-target-alerts).
# ALERTS_BOT_SPOOL_DIR=/var/lib/m-ranked/telegram-bot/inbox
# Имя сервера в событии (показывается в сообщении бота).
# ALERTS_SERVER_NAME=Сервер 2

# Пороги. Окно трафика — 5 минут по журналу nginx m-ranked-access.log.
ALERTS_BACKUP_HOURS=36
ALERTS_DISK_FREE_GB=6
# Load average за 5 минут ×10 (40 = 4.0 на двух ядрах).
ALERTS_LOAD5_X10=40
ALERTS_INGEST_MINUTES=20
ALERTS_ANALYSIS_LAG_MINUTES=180
ALERTS_DOCKER_GB=5
ALERTS_HUMAN_5XX=20
ALERTS_BOT_503_PERCENT=50
ALERTS_MISSES_PER_SECOND=20
ALERTS_HIT_RATIO_PERCENT=30
