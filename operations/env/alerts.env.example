# Тревоги в Telegram (m-ranked-target-alerts.timer, раз в минуту).
#
# Токен бота — отдельным файлом 0600 root:root, его кладёт владелец бота:
#   install -m 0600 /dev/stdin /etc/m-ranked/credentials/alerts-telegram-token
# Без токена или чата тревоги только пишутся в журнал службы.
ALERTS_TELEGRAM_CHAT_ID=
# ALERTS_TELEGRAM_TOKEN_FILE=/etc/m-ranked/credentials/alerts-telegram-token

# Пороги. Окно трафика — 5 минут по журналу nginx m-ranked-access.log.
ALERTS_BACKUP_HOURS=36
ALERTS_DISK_FREE_GB=6
# Load average за 5 минут ×10 (40 = 4.0 на двух ядрах).
ALERTS_LOAD5_X10=40
ALERTS_INGEST_MINUTES=20
ALERTS_ANALYSIS_LAG_MINUTES=180
ALERTS_DOCKER_GB=5
ALERTS_HUMAN_5XX=20
ALERTS_BOT_503_PERCENT=50
ALERTS_MISSES_PER_SECOND=20
ALERTS_HIT_RATIO_PERCENT=30
