# Тревоги Сервера 2 (m-ranked-target-alerts.timer, раз в минуту).
#
# Telegram напрямую не используется: события тревог кладутся файлами в очередь
# бота, если каталог существует (иначе только в журнал службы:
# journalctl -u m-ranked-target-alerts).
# ALERTS_BOT_SPOOL_DIR=/var/lib/m-ranked/telegram-bot/inbox
# Имя сервера в событии (показывается в сообщении бота).
# ALERTS_SERVER_NAME=Сервер 2

# Пороги. Окно трафика — 5 минут по журналу nginx m-ranked-access.log.
ALERTS_BACKUP_HOURS=36
ALERTS_DISK_FREE_GB=6
# Load average: среднее пятиминутных значений за 15 минут ×10 (60 = 6.0 на двух ядрах).
ALERTS_LOAD15_X10=60
# Процессор: среднее занятости за ALERTS_CPU_MINUTES минут выше порога, %.
ALERTS_CPU_PERCENT=90
ALERTS_CPU_MINUTES=45
# Срочная тревога «процессор + медленные страницы»: медиана p95 страниц за 15 мин, секунд.
ALERTS_PAGE_P95_SECONDS=3
# Память без кэша, % занято; подкачка, МБ.
ALERTS_MEMORY_PERCENT=90
ALERTS_SWAP_MB=1000
# Срочная тревога по диску: свободно меньше этого процента.
ALERTS_DISK_URGENT_PERCENT=7
# Срочная тревога по роботам: запросов в минуту выше порога подряд ALERTS_BOT_MINUTES минут.
ALERTS_BOTS_PER_MINUTE=150
ALERTS_BOT_MINUTES=5
ALERTS_INGEST_MINUTES=20
ALERTS_ANALYSIS_LAG_MINUTES=180
ALERTS_DOCKER_GB=5
ALERTS_HUMAN_5XX=20
ALERTS_BOT_503_PERCENT=50
ALERTS_MISSES_PER_SECOND=20
ALERTS_HIT_RATIO_PERCENT=30
