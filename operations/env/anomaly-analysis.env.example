ANOMALY_DATABASE_URL=postgresql://analytics_worker@127.0.0.1:5432/mranked?sslmode=prefer
ANOMALY_BATCH_SIZE=20
ANOMALY_LEASE_SECONDS=120
ANOMALY_MAX_POINTS=4096
ANOMALY_BACKFILL_BATCH_SIZE=50
ANOMALY_BACKFILL_INTERVAL_SECONDS=300
ANOMALY_RETRY_BASE_SECONDS=30
ANOMALY_RETRY_MAX_SECONDS=3600
ANOMALY_POLL_SECONDS=5
ANOMALY_METRICS_FILE=/var/lib/node_exporter/textfile_collector/mranked-anomaly.prom
