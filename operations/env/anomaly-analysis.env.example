ANOMALY_DATABASE_URL=postgresql://analytics_worker@127.0.0.1:5432/mranked?sslmode=prefer
ANOMALY_METRICS_FILE=/var/lib/node_exporter/textfile_collector/mranked-anomaly.prom
# Пачка — 50 постов одним запросом рядов; пауза между пустыми пачками.
ANOMALY_BATCH_SIZE=50
ANOMALY_POLL_SECONDS=5
# Окно отслеживания — то же значение, что у сборщиков: после него пост
# получает финальный анализ и замораживается.
TRACK_POST_FOR_HOURS=720
# Интервалы анализа по возрасту поста (секунды) — таблица раздела 4 плана.
# Значения по умолчанию заданы в коде; переопределяются так:
# ANOMALY_INTERVAL_DAY_1_SECONDS=900
# ANOMALY_INTERVAL_DAYS_2_3_SECONDS=2700
# ANOMALY_INTERVAL_DAYS_4_7_SECONDS=5400
# ANOMALY_INTERVAL_DAYS_8_30_SECONDS=10800
# ANOMALY_RUTUBE_INTERVAL_DAY_1_SECONDS=10800
# ANOMALY_RUTUBE_INTERVAL_DAYS_2_3_SECONDS=10800
# ANOMALY_RUTUBE_INTERVAL_DAYS_4_7_SECONDS=32400
# ANOMALY_RUTUBE_INTERVAL_DAYS_8_30_SECONDS=86400
# Деградация: при отставании очереди больше 15 минут интервалы 7–30 суток
# растягиваются до вчетверо; свежие посты не трогаются.
# ANOMALY_MAX_STRETCH=4
# ANOMALY_STRETCH_AFTER_LAG_SECONDS=900
# Перепроверка после новой принятой нормы расходится по этому окну.
# ANOMALY_RECHECK_WINDOW_SECONDS=21600
# Посты за столько часов ставятся в очередь анализа (сайт показывает 70 суток).
# ANOMALY_SEED_WINDOW_HOURS=1800
# Ночной пересчёт норм (m-ranked-target-anomaly-norms.timer) читает этот же файл.
ANOMALY_NORMS_METRICS_FILE=/var/lib/node_exporter/textfile_collector/mranked-anomaly-norms.prom
ANOMALY_NORM_WINDOW_DAYS=60
# Синтетический эталон строится в памяти из кода модуля. Здесь — только
# каталоги с выгруженными и размеченными реальными рядами; они лежат вне
# репозитория, потому что это данные вузов, а репозиторий публичный. Пусто —
# проверка идёт одной синтетикой.
ANOMALY_REFERENCE_DIRS=/var/lib/m-ranked/anomaly-reference

# Manual backfill admission; background worker behavior is unchanged.
MRANKED_STORAGE_PATH=/var/lib/m-ranked
MRANKED_BACKFILL_PEAK_BYTES=1000000000
