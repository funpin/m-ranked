# Installed as /etc/m-ranked/collector-profile.env on Profile B Server 1.
COLLECTOR_DEPLOYMENT_PROFILE=b
COLLECTOR_TRANSFER_MODE=https-mtls
COLLECTOR_TRANSFER_PRODUCER_ID=server-1
COLLECTOR_TRANSFER_HTTPS_ENDPOINT=https://192.0.2.20:8443/transfer/v1/batches
# Client certificate/key/CA paths are injected from LoadCredential by drop-in.
# Один слот сбора на каждую площадку.
#
# При одном слоте сбор всех четырёх идёт строго по очереди, а круг по
# измеренным p50 занимает около пятнадцати минут: Telegram 84 с, VK 121 с,
# MAX 84 с и Rutube 620 с. Пятиминутный слот в такой круг не помещается,
# цикл его перерастает, и планировщик схлопывает пропущенные слоты в
# один. В истории замеров это видно как ровный ряд по пять минут, а затем
# провал на пятнадцать-двадцать минут — ровно когда в обороте Rutube.
#
# Сбор — это почти целиком ожидание ответа площадки, процессор он не
# занимает, поэтому очередь здесь не экономит ничего. Запись остаётся
# строго последовательной под собственной блокировкой: при значении
# больше единицы включается отдельный страж записи.
#
# ADR-012 называет умеренным значением двойку — но для хоста, который
# делит ядро с web и API. На выделенном сервере сборщиков занижать
# нечего: слотов ровно столько, сколько площадок.
COLLECTOR_COLLECT_CONCURRENCY=4
# Сборщику нужны только месяцы, которые ещё отслеживаются; вся история живёт
# на Сервере 2. Без очистки база Сервера 1 прибавляет 0.3–0.4 ГБ в сутки и за
# несколько недель доводит диск до 90 %, где сбор встаёт. Месяц удаляется
# целиком и только после того, как вышел из окна отслеживания, а Сервер 2
# подтвердил всё, что создано до его последней строки.
#
# Оговорка для хоста, чью базу перенесли дампом, а не наполнили переносом:
# подтверждения там есть только у новых конвертов, и для старых месяцев они
# ничего не доказывают. Перед включением сверьте старые месяцы на обоих
# серверах (число строк и max(id) по published_month).
COLLECTOR_WORKING_SET_RETENTION=on
