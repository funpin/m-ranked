# Устанавливается как /etc/m-ranked/cache-warmup.env на Сервере 2 профиля B.
#
# Отдельный файл, а не api.env: прогрев обращается к API только по HTTP, но
# api.Settings строит DSN для каждой роли с заданным адресом и требует её
# пароль. Здесь адресов базы нет, поэтому и паролей не нужно.
API_DEPLOYMENT_PROFILE=b
# Порт API этого хоста. В примере api.env это 8080; если он занят, поставьте
# тот же порт, что в SERVER_PORT.
API_CACHE_WARMUP_BASE_URL=http://127.0.0.1:8080
# Страницы открываются с этими параметрами по умолчанию: главная — Telegram
# за сутки, статистика — все площадки за 30 дней. Ключ кэша строится из
# нормализованного запроса, поэтому греть надо ровно их.
API_CACHE_WARMUP_TARGETS=["/api/v1/overview?platform=telegram&period=1d&limit=50","/api/v1/overview?platform=vk&period=1d&limit=50","/api/v1/overview?platform=max&period=1d&limit=50","/api/v1/overview?platform=rutube&period=1d&limit=50","/api/v1/overview?platform=all&period=1d&limit=50","/api/v1/statistics?platform=all&period=30d&view=publications&limit=50","/api/v1/statistics?platform=telegram&period=30d&view=publications&limit=50","/api/v1/statistics?platform=vk&period=30d&view=publications&limit=50","/api/v1/statistics?platform=max&period=30d&view=publications&limit=50","/api/v1/statistics?platform=rutube&period=30d&view=publications&limit=50"]
# Проход повторяется раз в минуту и почти ничего не стоит: API пересобирает
# только ответы старше MAX_AGE. Каталог — карточки всех аккаунтов со списками
# постов и страницы постов за RECENT_HOURS; столько же отстаёт и он сам.
API_CACHE_WARMUP_INTERVAL_SECONDS=60
API_CACHE_WARMUP_CATALOG=true
API_CACHE_WARMUP_RECENT_HOURS=6
API_CACHE_WARMUP_MAX_AGE_SECONDS=600
API_CACHE_WARMUP_CONCURRENCY=1
API_CACHE_WARMUP_METRICS_FILE=/var/lib/node_exporter/textfile_collector/m-ranked-api-cache-warmup.prom
API_STATEMENT_TIMEOUT_MS=15000
