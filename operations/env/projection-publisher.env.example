PROJECTION_DATABASE_URL=postgresql://maintenance@127.0.0.1:5432/mranked?sslmode=prefer
PROJECTION_CAPACITY_PATH=/var/lib/postgresql
# Multiplies the explicitly estimated old/new heap+indexes, TEMP and WAL peak.
# Keep at 1 unless a production-shaped rebuild justifies a higher safety factor.
PROJECTION_CAPACITY_MULTIPLIER=1
PROJECTION_MIN_FREE_BYTES=5368709120
PROJECTION_LOCK_FILE=/run/m-ranked-projection-publisher/publisher.lock
