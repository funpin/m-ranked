# Упаковщик истории замеров (operations/runbooks/HISTORY_COMPACTION.md).
# Граница горячего слоя: замеры старше — в упакованную строку поста.
HISTORY_HOT_HOURS=48
# Постов на один запрос списка и бюджет прогона в минутах.
HISTORY_COMPACTION_BATCH=100
HISTORY_COMPACTION_MINUTES=20
# Пауза между пачками — доля времени работы (0.5 — база наполовину свободна).
HISTORY_COMPACTION_PACE=0.5
