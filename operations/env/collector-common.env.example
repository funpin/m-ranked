COLLECTOR_DATABASE_URL=postgresql://collector_ingest@127.0.0.1:5432/mranked?sslmode=prefer
MRANKED_IDENTITY_RECEIPT_DIR=/var/lib/m-ranked/identity-receipts
LOG_LEVEL=INFO
COLLECTOR_PERSIST_RAW_EVIDENCE=true
DATABASE_PATH=/var/lib/m-ranked/collectors/legacy-unused.db
WEB_HOST=127.0.0.1
WEB_PORT=8080
DISPLAY_TIMEZONE=Europe/Moscow
LOG_PATH=/var/lib/m-ranked/collectors/collector.log
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_CSRF_SECRET=
COLLECTOR_TELEGRAM_POLL_INTERVAL_SECONDS=300
COLLECTOR_VK_POLL_INTERVAL_SECONDS=300
COLLECTOR_MAX_POLL_INTERVAL_SECONDS=300
COLLECTOR_RUTUBE_POLL_INTERVAL_SECONDS=3600
COLLECTOR_VERSION=target-v1
# phased: four isolated workers share one PostgreSQL-backed exclusive phase.
# legacy is the immediate rollback path; shadow evaluates slots without calls.
COLLECTOR_SCHEDULE_MODE=phased
COLLECTOR_PHASE_MAX_WAIT_SECONDS=900
COLLECTOR_PHASE_RETRY_SECONDS=2
COLLECTOR_PHASE_REQUEST_STALE_SECONDS=120
COLLECTOR_SHUTDOWN_GRACE_SECONDS=45
COLLECTOR_TELEGRAM_CYCLE_DEADLINE_SECONDS=900
COLLECTOR_VK_CYCLE_DEADLINE_SECONDS=600
COLLECTOR_MAX_CYCLE_DEADLINE_SECONDS=600
COLLECTOR_RUTUBE_CYCLE_DEADLINE_SECONDS=1800
# Profile A default. disabled is the immediate rollback path; https-mtls is
# provisioned only in P2 and additionally requires endpoint/certificate paths.
# Профиль A — весь стек на одном сервере; профиль B — сборщики отдельно от
# представления. Профиль B требует https-mtls и всех четырёх путей ниже, иначе
# процесс не стартует: выяснять отсутствие сертификата в момент первой доставки
# поздно, данные уже собраны.
COLLECTOR_DEPLOYMENT_PROFILE=a
# Потолок одновременных фаз сбора. Единица — поведение до разделения фаз.
# Поднимать до 2 только после того, как API, web и аналитика уехали на Сервер 2:
# параллельный сбор стоит памяти и CPU, которых у профиля A нет. Откат —
# вернуть 1, кода это не требует.
# Размещение аккаунтов между Серверами 1. Пустой membership означает один
# хост: он собирает всё, как раньше. Формат: server:platform|platform, через
# запятую. Пул строится по площадкам, которые хост реально может обслужить —
# у MAX и Telegram учётные данные привязаны к хосту.
COLLECTOR_SERVER_ID=server-1
# Пример многохостовой конфигурации:
#   server-1:telegram|vk|max|rutube,server-2:telegram|vk|rutube
COLLECTOR_MEMBERSHIP=
# Фактор репликации на площадку. 1 — чистый шардинг, 2 — шардинг с копиями,
# равный размеру пула — полное дублирование. Больше единицы кратно умножает
# расход квот: у ВК это связывающее ограничение раньше, чем процессор.
COLLECTOR_REPLICATION_TELEGRAM=1
COLLECTOR_REPLICATION_VK=1
COLLECTOR_REPLICATION_MAX=1
COLLECTOR_REPLICATION_RUTUBE=1
COLLECTOR_COLLECT_CONCURRENCY=1
COLLECTOR_PERSIST_WAIT_SECONDS=120
# Обрезка рабочего набора. Единственный необратимый шаг плана перехода, поэтому
# по умолчанию выключена и разрешена только в профиле B. Порядок включения:
# dry-run, сверить отчёт, затем on. Освобождаются целые месяцы наблюдений,
# вышедшие из окна TRACK_POST_FOR_HOURS и подтверждённые Сервером 2.
COLLECTOR_WORKING_SET_RETENTION=off
COLLECTOR_WORKING_SET_MONTHS_PER_RUN=1
COLLECTOR_DISK_PATH=/var/lib/m-ranked
COLLECTOR_TRANSFER_MODE=in-process
COLLECTOR_TRANSFER_PRODUCER_ID=server-1
# COLLECTOR_TRANSFER_HTTPS_ENDPOINT=https://ready.example/internal/transfer/v1
# COLLECTOR_TRANSFER_CLIENT_CERTIFICATE=/etc/m-ranked/transfer/client.crt
# COLLECTOR_TRANSFER_PRIVATE_KEY=/etc/m-ranked/transfer/client.key
# COLLECTOR_TRANSFER_CA_BUNDLE=/etc/m-ranked/transfer/ca.crt
DISCOVERY_LIMIT=200
COLLECTOR_REFRESH_LIMIT=100
COLLECTOR_REFRESH_SCAN_LIMIT=400
PUBLICATION_SNAPSHOT_HEARTBEAT_HOURS=24
# Окно отслеживания: 30 суток. После него плановое обновление поста
# прекращается, а уже собранные замеры остаются. Это же окно читает модуль
# анализа, чтобы сделать финальный проход ровно тогда, когда сбор кончился.
TRACK_POST_FOR_HOURS=720
DELETION_CONFIRMATION_CHECKS=2
RETENTION_DAYS=70
COMPLETE_HISTORY_MAX_FIRST_AGE_MINUTES=6
TELEGRAM_HISTORY_PAGES=1
POLL_INTERVAL_MINUTES=5
JUMP_MIN_ABS=15
JUMP_MIN_RATIO=2
DISCOVERY_OVERLAP=20
RECENT_POST_HOURS=24
MEDIUM_POST_HOURS=168
MEDIUM_POLL_INTERVAL_MINUTES=15
OLD_POLL_INTERVAL_MINUTES=180
SUBSCRIBER_REFRESH_HOURS=24
SECOND_DAY_POLL_INTERVAL_MINUTES=15
THIRD_DAY_POLL_INTERVAL_MINUTES=15
DAYS_4_TO_6_POLL_INTERVAL_MINUTES=30
DAYS_7_TO_13_POLL_INTERVAL_MINUTES=60
DAY_14_PLUS_POLL_INTERVAL_MINUTES=60
RUTUBE_FIRST_THREE_DAYS_POLL_INTERVAL_MINUTES=60
RUTUBE_DAYS_4_TO_6_POLL_INTERVAL_MINUTES=180
RUTUBE_DAYS_7_TO_13_POLL_INTERVAL_MINUTES=360
RUTUBE_DAY_14_PLUS_POLL_INTERVAL_MINUTES=720
ARCHIVE_DIR=/var/lib/m-ranked/collectors/archives

# Local disk admission: finish current cycle; sender remains independent.
COLLECTOR_DISK_PAUSE_FREE_BYTES=2000000000
COLLECTOR_DISK_RESUME_FREE_BYTES=3000000000
