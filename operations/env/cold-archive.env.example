# Конвейер холодного архива (ADR-016). База — MAINTENANCE_DATABASE_URL из
# maintenance.env. Срок горячего хранения задаёт панель (политика storage);
# значение ниже — только на случай, если политики в базе нет.
COLD_ARCHIVE_AFTER_DAYS=30
# Сколько месяц может быть закрыт для записи, ожидая копию на другом сервере.
COLD_ARCHIVE_FENCE_MINUTES=120
# Пауза после каждого поста черновика — доля времени его расчёта.
COLD_ARCHIVE_PACE=1.0
