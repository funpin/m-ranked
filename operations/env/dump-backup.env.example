BACKUP_DATABASE=mranked
BACKUP_DB_USER=mranked_backup
BACKUP_DIR=/var/backups/m-ranked
BACKUP_KEEP=1
MRANKED_DB_CONTAINER=m-ranked-postgres
# Через сколько часов убирать оборванные снимки. Они остаются для разбора,
# но весят как готовый дамп и сами не исчезают.
BACKUP_PARTIAL_MAX_AGE_HOURS=24

# S2 proposal: new dump cap + 20% operating reserve, enforced during streaming.
# 25.09 дамп перерос 5 ГБ (gzip) и был остановлен потолком; zstd:3 и 7 ГБ.
BACKUP_MAX_DUMP_BYTES=7000000000
BACKUP_RESERVE_BYTES=11000000000

# Потолок скорости потока дампа, байт/с: дамп не отнимает процессор у приёма
# данных. 10 МБ/с — снимок ~4 ГБ за 7 минут ночью.
BACKUP_MAX_BYTES_PER_SECOND=10000000
# Процессор контейнера pg_dump и проверки архива.
BACKUP_CPUS=0.5
# Сжатие архива pg_dump.
BACKUP_COMPRESSION=zstd:3
# Метрики последнего успешного снимка для тревоги MRankedBackupStale.
BACKUP_METRICS_FILE=/var/lib/node_exporter/textfile_collector/mranked-backup.prom
