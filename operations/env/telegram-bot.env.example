# Необязательный Telegram-бот (m-ranked-target-telegram-bot.service).
# Копия лежит в /etc/m-ranked/telegram-bot.env. Токен сюда не пишется: его
# отдаёт systemd из /etc/m-ranked/credentials/telegram-bot-token, а пароль
# базы — из telegram-bot-pgpass (PGPASSFILE выставляет юнит).

# Telegram ID админов через запятую. При первом запуске оставьте пустым: бот
# отвечает только на /start и /id. Отправьте боту /id, впишите ответ сюда и
# перезапустите службу.
TELEGRAM_BOT_ADMIN_IDS=

# Локальный API; можно не задавать.
TELEGRAM_BOT_API_BASE_URL=http://127.0.0.1:8080

# Строка подключения libpq без пароля, роль telegram_bot, например
# "host=<адрес базы> dbname=<база> user=telegram_bot" (формат — как у
# *_DATABASE_URL в соседних примерах).
TELEGRAM_BOT_DSN=

# Очередь тревог от alerts.py; по умолчанию:
# TELEGRAM_BOT_SPOOL_DIR=/var/lib/m-ranked/telegram-bot/inbox
