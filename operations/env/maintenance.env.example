MAINTENANCE_DATABASE_URL=postgresql://maintenance@127.0.0.1:5432/mranked?sslmode=prefer
MAINTENANCE_PARTITIONS_AHEAD=2
MAINTENANCE_ENABLE_RAW_PURGE=false
MAINTENANCE_RAW_PURGE_BATCH_SIZE=1000
MAINTENANCE_RAW_PURGE_MAX_BATCHES=10

# Enable only after storage-indexes.sql + migration 0040 and approved rollout.
MAINTENANCE_ENABLE_OUTBOX_PURGE=true
MAINTENANCE_OUTBOX_BATCH_SIZE=1000
MAINTENANCE_OUTBOX_MAX_BATCHES=20
MAINTENANCE_OUTBOX_MAX_SECONDS=20

# Enable after granting this service access to the existing textfile directory.
MAINTENANCE_METRICS_FILE=/var/lib/node_exporter/textfile_collector/mranked_cache_outbox.prom

# Старые ревизии набора данных (миграция 0042, индексы storage-indexes.sql).
MAINTENANCE_ENABLE_REVISION_PURGE=true
MAINTENANCE_REVISION_KEEP_DAYS=7
MAINTENANCE_REVISION_BATCH_SIZE=5000
MAINTENANCE_REVISION_MAX_BATCHES=20
MAINTENANCE_REVISION_MAX_SECONDS=60

# Готовая история постов с законченным сбором (m-ranked-target-history-pages,
# миграция 0043). Прогон ограничен по времени и идёт вполсилы: после каждого
# поста пауза не меньше времени его расчёта (PACE=1.0).
HISTORY_PAGES_MAX_SECONDS=240
HISTORY_PAGES_MIN_AGE_DAYS=41
HISTORY_PAGES_RECHECK=200
HISTORY_PAGES_PACE=1.0

# Сводка главной страницы (миграция 0044): пересчёт, если строке больше
# стольких часов; остальные прогоны — одна дешёвая проверка.
MAINTENANCE_ENABLE_SITE_SUMMARY=true
MAINTENANCE_SITE_SUMMARY_MAX_AGE_HOURS=23
