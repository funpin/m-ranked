OPERATOR_ID=replace-with-named-human-operator
CHANGE_TICKET=replace-with-approved-change-id
TARGET_API_URL=http://127.0.0.1:8080/api/v1/health/ready
TARGET_WEB_URL=http://127.0.0.1:3000/
LEGACY_HEALTH_URL=http://127.0.0.1:8090/health
TARGET_DATABASE_URL=postgresql://api_read@127.0.0.1:5432/mranked?sslmode=prefer
TARGET_PGPASSFILE=/etc/m-ranked/credentials/api-read-pgpass
OUTBOX_DATABASE_URL=postgresql://api_write_admin@127.0.0.1:5432/mranked?sslmode=prefer
OUTBOX_PGPASSFILE=/etc/m-ranked/credentials/outbox-pgpass
BACKUP_MONITOR_DATABASE_URL=postgresql://backup@127.0.0.1:5432/mranked?sslmode=prefer
BACKUP_PGPASSFILE=/etc/m-ranked/credentials/backup-pgpass
RECONCILIATION_REPORT=/var/lib/m-ranked/migration-reports/s-final.json
RESTORE_VERIFICATION_REPORT=/var/lib/m-ranked/restore-reports/latest.json
CONTRACT_GATE_REPORT=/var/lib/m-ranked/release-gates/contracts.json
VISUAL_GATE_REPORT=/var/lib/m-ranked/release-gates/visual.json
PERFORMANCE_GATE_REPORT=/var/lib/m-ranked/release-gates/performance.json
# Set a new approval/release-scoped path for every accepted shadow run. The
# sealer never overwrites a report or its sidecar.
COLLECTOR_PARITY_REPORT=
COLLECTOR_PARITY_EVIDENCE_ROOT=/var/lib/m-ranked/release-gates/collector-parity
COLLECTOR_PARITY_MAX_AGE_SECONDS=86400
# Dedicated external collector-evidence approval; not the deploy change ticket.
COLLECTOR_PARITY_APPROVAL_TICKET=
DEPLOY_REPORT=/var/lib/m-ranked/deploy-reports/current.json
# Set both values only for one independently approved run. The evidence path
# must be new and approval/release scoped because the producer never clobbers.
REVERSE_SYNC_REHEARSAL_REPORT=
REVERSE_SYNC_REHEARSAL_MAX_AGE_SECONDS=86400
# Independent approval recorded for the release-bound reverse-sync rehearsal.
# It is intentionally not inferred from the general cutover CHANGE_TICKET.
REVERSE_SYNC_APPROVAL_TICKET=
MRANKED_INSTALL_ROOT=/opt/m-ranked/releases
MRANKED_CURRENT_LINK=/opt/m-ranked/current
DATA_FILESYSTEM_PATH=/var/lib/postgresql
RECONCILIATION_MAX_AGE_SECONDS=1800
RESTORE_REPORT_MAX_AGE_SECONDS=86400
MAX_OUTBOX_LAG_SECONDS=60
MAX_WAL_ARCHIVE_AGE_SECONDS=900
MAX_REPLICA_LAG_SECONDS=900
MAX_DISK_PERCENT=69
ROLLBACK_WINDOW_HOURS=72
# Change to true only after the production-like collector and reverse-sync
# Gate W reports for this release have both been approved.
COMPATIBILITY_SYNC_READY=false
REVERSE_SYNC_EXECUTABLE=/opt/m-ranked/current/operations/bin/pg-to-legacy-sync
REVERSE_SYNC_JOURNAL_PATH=/var/lib/m-ranked-reverse-sync/journal.sqlite3
REVERSE_SYNC_REPORT_PATH=/var/lib/m-ranked-reverse-sync/latest.json
REVERSE_SYNC_MIN_FREE_BYTES=268435456
REVERSE_SYNC_POLL_SECONDS=5
LEGACY_SQLITE_PATH=/opt/telegram-reaction-monitor/data/reactions.db
MIGRATION_SNAPSHOT_DIR=/var/lib/m-ranked/migration-snapshots
MIGRATION_REPORT_DIR=/var/lib/m-ranked/migration-reports
MIGRATION_SOURCE_NAMESPACE=m-ranked-production
# Explicit reverse URL uses migration_bridge until a separately reviewed
# post-V8 migration creates a narrower reverse-sync role.
REVERSE_SYNC_DATABASE_URL=postgresql://migration_bridge@127.0.0.1:5432/mranked?sslmode=prefer
MIGRATION_DATABASE_URL=postgresql://migration_bridge@127.0.0.1:5432/mranked?sslmode=prefer
MIGRATION_PGPASSFILE=/etc/m-ranked/credentials/migration-bridge-pgpass
NGINX_ACTIVE_ROUTES=/etc/m-ranked/nginx/routes-active.conf
NGINX_CONFIG=/etc/nginx/nginx.conf
ROUTING_REPORT_DIR=/var/lib/m-ranked/cutover
