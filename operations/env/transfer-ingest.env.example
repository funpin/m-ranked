# Приёмник transfer на Сервере 2. Слушает только внутренний интерфейс:
# firewall пропускает сюда исключительно Серверы 1 или VPN-подсеть.
# Replace with Server 2's internal/VPN address; never bind the public address.
TRANSFER_INGEST_HOST=192.0.2.20
TRANSFER_INGEST_PORT=8443
TRANSFER_INGEST_PATH=/transfer/v1/batches
TRANSFER_INGEST_DATABASE_URL=postgresql://collector_ingest@127.0.0.1:5432/mranked?sslmode=prefer
# mTLS paths are injected from LoadCredential by the unit.
# Разрешённые удостоверения производителей: common name клиентского
# сертификата. Пустое значение принимает любой сертификат, подписанный CA.
TRANSFER_INGEST_ALLOWED_PRODUCERS=server-1
# Та же opt-in когорта, что у сборщика; пусто = не сохранять per-post receipts.
PUBLICATION_POLL_RECEIPT_ACCOUNT_IDS=
TRANSFER_INGEST_METRICS_FILE=/var/lib/node_exporter/textfile_collector/m-ranked-transfer-ingest.prom
LOG_LEVEL=INFO

# Сырые доказательства на приёмнике не нужны.
#
# Применяя пачку, приёмник идёт тем же путём записи, что и сборщик, и по
# умолчанию материализует сырое доказательство на каждое наблюдение. На
# Сервере 1 это намеренно выключено ради места; на Сервере 2 флаг забывали
# задать, и каталог набирал триста тысяч файлов и больше гигабайта за сутки.
# Ни API, ни анализ аномалий их не читают: Сервер 2 отдаёт готовые данные.
COLLECTOR_PERSIST_RAW_EVIDENCE=false

# Сколько держать тело применённого конверта: уходит полезная нагрузка,
# которая после применения уже нигде не нужна. Окно нужно на случай, если
# применение придётся разбирать вручную.
TRANSFER_INGEST_PAYLOAD_RETENTION_HOURS=6
TRANSFER_INGEST_PAYLOAD_RELEASE_INTERVAL_SECONDS=300
TRANSFER_INGEST_PAYLOAD_RELEASE_LIMIT=2000
# Сколько суток держать саму квитанцию применённого конверта (0060): по ней
# узнаётся повторная доставка, а Сервер 1 подтверждённое удаляет через сутки
# и больше не шлёт. Старше — удаляется с событиями, счётчики сворачиваются.
TRANSFER_INGEST_RECEIPT_RETENTION_DAYS=7
TRANSFER_INGEST_RECEIPT_PRUNE_LIMIT=5000
# Сколько объектов сырых доказательств осматривать за проход уборки.
# Склад своей сборки мусора не имел: функция удаления написана, но её никто
# не вызывал, и каталог рос без предела.
# Шаг уборки склада — свой и редкий: каждый объект стоит блокировки и
# запроса к базе, а удалять обычно нечего.
TRANSFER_INGEST_EVIDENCE_PURGE_INTERVAL_SECONDS=3600
TRANSFER_INGEST_EVIDENCE_PURGE_LIMIT=5000

# Узловые точки агентов хранилища /node/v1/* (ADR-016): отчёты серверов,
# задания и куски файлов. off выключает их, перенос замеров не затрагивается.
TRANSFER_INGEST_NODE_HUB=on
# Хранилище резервных копий и холодного архива основного сервера.
MRANKED_STORE_DIR=/var/lib/m-ranked/store
