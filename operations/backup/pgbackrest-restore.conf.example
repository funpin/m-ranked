[global]
archive-timeout=900
log-level-console=info
log-level-file=off
process-max=2

# Install only on the isolated DR verifier. The three repository endpoints and
# cipher secrets must match the primary configuration, but the verifier receives
# no PostgreSQL primary credential and no write access to production PGDATA.
repo1-host=m-ranked-dr.internal
repo1-host-user=m-ranked-backup-read
repo1-host-config=/etc/m-ranked/credentials/pgbackrest-repository-read.conf
repo1-path=/srv/m-ranked/pgbackrest/daily
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_DAILY_REPOSITORY_SECRET

repo2-host=m-ranked-dr.internal
repo2-host-user=m-ranked-backup-read
repo2-host-config=/etc/m-ranked/credentials/pgbackrest-repository-read.conf
repo2-path=/srv/m-ranked/pgbackrest/weekly
repo2-cipher-type=aes-256-cbc
repo2-cipher-pass=REPLACE_WITH_WEEKLY_REPOSITORY_SECRET

repo3-host=m-ranked-dr.internal
repo3-host-user=m-ranked-backup-read
repo3-host-config=/etc/m-ranked/credentials/pgbackrest-repository-read.conf
repo3-path=/srv/m-ranked/pgbackrest/monthly
repo3-cipher-type=aes-256-cbc
repo3-cipher-pass=REPLACE_WITH_MONTHLY_REPOSITORY_SECRET

[m-ranked]
# restore-verify.sh overrides this with a fresh verify.XXXXXX/pgdata path on
# every run. Keep this placeholder outside every production PostgreSQL path.
pg1-path=/var/lib/m-ranked/restore-verify/unused-pgdata-placeholder
