# Секрет подписи куки проверки на браузер (pass.js). Ставится в
# /etc/m-ranked/nginx/pass-secret.conf с правами 0600 root:root и в
# репозиторий не попадает. Значение — 64 шестнадцатеричных символа:
#   openssl rand -hex 32
# Смена секрета сбрасывает куки у всех: каждый посетитель один раз пройдёт
# проверку заново. Пустой или короткий секрет выключает проверку (pass.js пишет
# ошибку в журнал nginx и пускает всех).
map "" $m_ranked_pass_secret {
    default "REPLACE_WITH_OPENSSL_RAND_HEX_32";
}
