# Дополнительные имена для того же сайта.
#
# Нужен, когда основное имя ещё указывает на прежний сервер, а новый уже надо
# открыть людям: DNS переносится последним шагом, а проверять новый сервер
# нужно раньше. Имена перечисляются через пробел, сертификат берётся тот,
# который их покрывает.
#
# upstream и limit_req_zone объявлены в m-ranked.conf — здесь только server.
# Файл кладётся в /etc/nginx/conf.d/ рядом с ним.

server {
    listen 80;
    listen [::]:80;
    server_name m.example.ru m.example.su;

    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name m.example.ru m.example.su;

    ssl_certificate /etc/letsencrypt/live/REPLACE-WITH-CERT/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE-WITH-CERT/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MRANKED_TLS_EXTRA:10m;
    client_max_body_size 1m;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_types application/javascript application/json application/problem+json
        application/wasm image/svg+xml text/css text/plain;

    location ^~ /api/v1/admin/ {
        limit_req zone=m_ranked_admin burst=10 nodelay;
        proxy_pass http://m_ranked_api;
        include /etc/m-ranked/nginx/proxy-common.conf;
        include /etc/m-ranked/nginx/security-headers.conf;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" always;
    }

    location ^~ /api/v1/ {
        limit_req zone=m_ranked_api burst=20 nodelay;
        proxy_pass http://m_ranked_api;
        include /etc/m-ranked/nginx/proxy-common.conf;
        include /etc/m-ranked/nginx/security-headers.conf;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" always;
    }

    location ^~ /_next/static/ {
        alias /opt/m-ranked/current/frontend/.next/static/;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/m-ranked/nginx/security-headers.conf;
    }

    location / {
        limit_req zone=m_ranked_public burst=40 nodelay;
        proxy_pass http://m_ranked_web;
        include /etc/m-ranked/nginx/proxy-common.conf;
    }

    include /etc/m-ranked/nginx/security-headers.conf;
}
