# Дополнительные имена для того же сайта.
#
# Нужен, когда основное имя ещё указывает на прежний сервер, а новый уже надо
# открыть людям: DNS переносится последним шагом, а проверять новый сервер
# нужно раньше. Имена перечисляются через пробел, сертификат берётся тот,
# который их покрывает.
#
# upstream, зоны и шлюз рендера объявлены в m-ranked.conf и traffic.conf —
# здесь только server; location общие, из site.conf. Файл кладётся в
# /etc/m-ranked/nginx/extra-hosts/: m-ranked.conf подключает его после
# traffic.conf. В conf.d он мог бы прочитаться раньше и сломать nginx -t.

server {
    listen 80;
    listen [::]:80;
    server_name m.example.ru m.example.su;

    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name m.example.ru m.example.su;

    ssl_certificate /etc/letsencrypt/live/REPLACE-WITH-CERT/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE-WITH-CERT/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MRANKED_TLS_EXTRA:10m;
    client_max_body_size 1m;
    server_tokens off;

    include /etc/m-ranked/nginx/site.conf;
}
