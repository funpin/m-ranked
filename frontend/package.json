{
  "name": "m-ranked-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:contract": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --lib ES2022,DOM,DOM.Iterable ../contracts/openapi/m-ranked-v1-client.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm check:api && pnpm test && pnpm test:e2e && pnpm build && pnpm check:bundle",
    "generate:api": "node scripts/generate-openapi.mjs",
    "check:api": "node scripts/generate-openapi.mjs --check",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:visual": "node --import tsx scripts/visual-parity.mts",
    "check:bundle": "node scripts/bundle-budget.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@mranked/legacy-chart": "workspace:*",
    "chart.js": "4.4.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "1.45.0",
    "next": "16.3.3",
    "openapi-fetch": "0.17.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "openapi-typescript": "7.13.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
