{
  "name": "m-ranked-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:contract": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --lib ES2022,DOM,DOM.Iterable ../contracts/openapi/m-ranked-v1-client.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm check:api && pnpm test && pnpm test:e2e && pnpm build && pnpm check:bundle",
    "generate:api": "node scripts/generate-openapi.mjs",
    "check:api": "node scripts/generate-openapi.mjs --check",
    "generate:contributors": "node scripts/generate-contributors.mjs",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/bundle-budget.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "input-otp": "1.5.0",
    "lenis": "1.3.27",
    "lucide-react": "1.64.0",
    "motion": "14.8.0",
    "next": "16.4.3",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-use-measure": "^2.1.7",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cyclonedx/cdxgen": "12.9.0",
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "yaml": "2.9.1"
  }
}
